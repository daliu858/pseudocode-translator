# Python
__pycache__/
*.pyc
.pytest_cache/

# ── Copyright guard ─────────────────────────────────────────────────────
# This public repository must never contain third-party copyrighted
# material (past papers, mark schemes, official guides, textbooks) or
# anything derived from it. These patterns are a safety net: the material
# itself lives outside this repository.
*.pdf
*.docx
*.doc
*.pseudo
corpus/
corpus_*/
completion_engine/
incoming/
docs/references/
docs/completion-engine/

# Local-only research/scratch artifacts
.q3review/
.agents/
.codex/
tmp/
_kimi_*
temp*.docx
transcript*_output.txt
*.png
*.jpg

# IDE user workspace (user files created via OPENFILE/WRITEFILE)
ide/workspace/

# Secrets — never commit credentials of any kind
*.key
*.pem
.env
.env.*
